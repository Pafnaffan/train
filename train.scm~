;;;  Exemples de départ.

(define (derive-wrt f1 h)
  (lambda (x) (/ (- (f1 (+ x h)) (f1 x)) h)))

(writeln/return ((derive-wrt sin 0.00001) 0.0))
(writeln/return ((derive-wrt square 0.00001) 3.0))
(writeln/return ((derive-wrt + 0.00001) 4.0))

(define (right-reduce f2 l init-value)
  (if (null? l) init-value (f2 (car l) (right-reduce f2 (cdr l) init-value))))

(writeln/return (right-reduce - '(26 1 2026 2027) 2028))

(define (left-reduce f2 l init-value)
  (if (null? l) init-value (left-reduce f2 (cdr l) (f2 init-value (car l)))))

(writeln/return (left-reduce - '(26 1 2026 2027) 2028))

(define (fact n)
  (if (negative? n)
      #f
      (let tr-fact ((counter n)
                    (accumulator 1))
        ;;  "-tr" est mis pour "tail-recursive".
        (if (null? counter)
            accumulator
            (tr-fact (- counter 1) (* accumulator counter))))))

