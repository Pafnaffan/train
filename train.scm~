(define (list-rd? x)
  (let loop ((slow x)
             (fast x)
             (after-beginning? #f))
    (cond ((null? fast) #t)
          ((and after-beginning? (eq? fast slow)) #f)
          ((pair? fast)
           (let ((next (cdr fast)))
             (cond ((null? next) #t)
                   ((pair? next) (loop (cdr slow) (cdr next) #t))
                   (else #f))))
          (else #f))))

(define (list-length? x)
  (let loop ((slow x)
             (fast x)
             (accumulator 0))
    (cond ((null? fast) accumulator)
          ((and (positive? accumulator) (eq? fast slow)) #f)
          ((pair? fast)
           (let ((next (cdr fast)))
             (cond ((null? next) (+ accumulator 1))
                   ((pair? next) (loop (cdr slow) (cdr next) (+ accumulator 2)))
                   (else #f))))
          (else #f))))